{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scout",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-07",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 9 * * MON,THU"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "SCOUT_DB",
      "database_name": "scout",
      "database_id": "428343b6-4c59-4a7b-a793-0781ec1c72ae",
      "migrations_dir": "./migrations"
    }
  ]
}
